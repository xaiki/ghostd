# ghostd — installation and recovery instructions: README.md.
[Unit]
Description=ghostd — tailnet-authenticated firewall/netconfig/ingress daemon
# tailscaled.service: ghostd binds its RPC listener to the tailnet address
# alone, waiting for it while configured LAN DHCP/DNS remains available.
# Start after tailscaled has a chance to be up. network-pre.target:
# same reasoning one layer down, for whatever brings the interface
# tailscaled itself rides up. Neither is a hard Requires=: a host whose
# tailscaled is flapping should not take ghostd down with it — the boot-time
# last-good restore (which does not depend on either) is what keeps the
# host's own firewall/netconfig state intact regardless.
After=network-pre.target tailscaled.service
Wants=network-pre.target tailscaled.service

[Service]
Type=notify
RuntimeDirectory=ghostd
RuntimeDirectoryMode=0755
ExecStart=/opt/ghostd/ghostd --watchdog-sec=30
Restart=always
RestartSec=5
WatchdogSec=30
# Root is the point: this daemon owns nftables/netconfig, the same
# surfaces firewalld's polkit grant used to reach for a different user.
# What changed is the authentication path (docs/security.md), not the
# privilege level the work itself has always needed.
User=root

[Install]
WantedBy=multi-user.target
