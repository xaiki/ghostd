FROM docker.io/library/debian:bookworm-slim
RUN apt-get -o Acquire::Max-FutureTime=10800 update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends systemd dbus dnsmasq iproute2 isc-dhcp-client busybox ndisc6 tcpdump iputils-ping nftables python3 ca-certificates procps avahi-daemon dnsutils python3-zeroconf mdns-scan && rm -rf /var/lib/apt/lists/*
WORKDIR /lab
